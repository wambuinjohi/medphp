# Database Provider Configuration
# Options: 'supabase', 'mysql', 'external-api'
VITE_DATABASE_PROVIDER=external-api

# External API Configuration (for med.wayrus.co.ke backend)
# When VITE_DATABASE_PROVIDER=external-api, set this to the API endpoint
VITE_EXTERNAL_API_URL=https://med.wayrus.co.ke/api.php

# Keep these for backward compatibility, but they won't be used if external-api is selected
# Supabase Configuration (only used when VITE_DATABASE_PROVIDER=supabase)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key (only used for admin operations with Supabase)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MySQL Configuration (only used when VITE_DATABASE_PROVIDER=mysql with local backend)
# DB_HOST=localhost
# DB_USER=your-user
# DB_PASS=your-password
# DB_NAME=your-database
# DB_PORT=3306

# JWT Configuration
JWT_SECRET=wayrus-secret-key-2024

# Application Settings
VITE_APP_NAME=Wayrus Medical
VITE_APP_LOGO_URL=
VITE_COMPANY_LOGO_BUCKET=company-logos
